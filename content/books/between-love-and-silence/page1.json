  "sentences": [
    {
      "sentence_id": 1,
      "arabic_di": "كَانَتِ الْغُرْفَةُ صَغِيرَةً بِمَا يَكْفِي لِيَشْعُرَ فِيهَا بِوَزْنِ التَّفْكِيرِ.",
      "transliteration": "Kānat al-ghurfatu ṣaghīratan bimā yakfī liyashʿura fīhā bi-wazn al-tafkīr.",
      "english": "The room was small enough for him to feel the weight of thinking in it.",
      "words": [
        {
          "arabic_di": "كَانَتِ",
          "transliteration": "kānat",
          "english": "was (feminine)",
          "pos": "verb",
          "cefr": "A0",
          "db_link": 487,
          "grammar_note": "The ت at the end means the subject is feminine. Here the subject is 'the room' (feminine in Arabic).",
          "arabic_plain": "كانت"
        },
        {
          "arabic_di": "الْغُرْفَةُ",
          "transliteration": "al-ghurfatu",
          "english": "the room",
          "pos": "noun",
          "cefr": "A0",
